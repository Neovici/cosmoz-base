{
	"name": "@neovici/cosmoz-base",
	"version": "0.0.0",
	"type": "module",
	"description": "Headless behaviour hooks for cosmoz web components, modelled on Base UI",
	"keywords": [
		"pionjs",
		"web-components",
		"accessibility",
		"headless"
	],
	"homepage": "https://github.com/Neovici/cosmoz-base#readme",
	"bugs": {
		"url": "https://github.com/Neovici/cosmoz-base/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Neovici/cosmoz-base.git"
	},
	"license": "Apache-2.0",
	"scripts": {
		"lint": "tsc && eslint --cache .",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"test:watch": "vitest",
		"prepare": "husky",
		"prettier": "prettier --write \"**/*.{js,ts,json,md}\"",
		"prettier:check": "prettier --check \"**/*.{js,ts,json,md}\"",
		"changeset": "changeset"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/"
	],
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		],
		"rules": {
			"body-max-line-length": [
				1,
				"always",
				600
			]
		}
	},
	"exports": {
		".": "./dist/index.js"
	},
	"peerDependencies": {
		"@pionjs/pion": "^2.7.1"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^20.0.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@neovici/cfg": "^2.8.0",
		"@pionjs/pion": "^2.16.1",
		"@types/node": "24.0.0",
		"@vitest/browser": "^4.0.0",
		"@vitest/browser-playwright": "^4.0.0",
		"eslint": "^9.0.0",
		"husky": "^9.0.0",
		"lint-staged": "^16.2.7",
		"lit-html": "^3.0.0",
		"playwright": "1.60.0",
		"vitest": "^4.0.0"
	}
}
